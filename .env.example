# Создать бота через @BotFather в Telegram, команда /newbot
BOT_TOKEN=

# Написать что-нибудь своему новому боту, затем открыть в браузере
# https://api.telegram.org/bot<TOKEN>/getUpdates и взять message.chat.id
CHAT_ID=

# Как часто проверять сайт, в минутах
POLL_INTERVAL_MINUTES=15

# Максимально допустимая площадь квартиры, м² (50 - норма, до 55 - запас)
MAX_WOHNFLAECHE_QM=55

# Радиус поиска вокруг города, км (0 = только сам город)
SEARCH_RADIUS_KM=0

# Во сколько раз завышаем цену в самом поиске на сайте относительно лимита
# Kaltmiete по городу - см. README, раздел "Почему цена в поиске выше лимита"
SEARCH_PRICE_BUFFER=1.3

# Сколько объявлений с первой страницы (сортировка по дате) проверять за
# один цикл на город
MAX_LISTINGS_PER_CITY=50

LOG_RETENTION_DAYS=14

# Необязательно: classic PAT с правами repo - для синхронизации "уже видел"
# между локальным ботом и облачным workflow (см. sync.py). Без него
# синхронизация просто выключена.
GITHUB_TOKEN=
